#!/usr/sbin/nft -f

# This disposable lab VM is dedicated to RabbitMQ, so this role owns
# the complete host firewall ruleset.
flush ruleset

table inet netology_rabbitmq {
{% if groups['rabbitmq'] | length > 1 %}
    set rabbitmq_nodes_v4 {
        type ipv4_addr
        elements = {
{% for host in groups['rabbitmq'] %}
            {{ hostvars[host].ansible_host }}{% if not loop.last %},{% endif %}
{% endfor %}
        }
    }
{% endif %}

    chain input {
        type filter hook input priority filter; policy drop;

        iifname "lo" accept

        ct state invalid drop
        ct state established,related accept

        ip protocol icmp accept
        meta l4proto ipv6-icmp accept

        # Administration from the lab admin network.
        ip saddr {{ rabbitmq_admin_cidr }} tcp dport {{ rabbitmq_ssh_port }} accept
        ip saddr {{ rabbitmq_admin_cidr }} tcp dport {{ rabbitmq_management_tls_port }} accept

        # AMQP clients use TLS only.
        ip saddr {{ rabbitmq_client_cidr }} tcp dport {{ rabbitmq_amqp_tls_port }} accept

{% if groups['rabbitmq'] | length > 1 %}
        # Erlang peer discovery and distribution are cluster-internal only.
        ip saddr @rabbitmq_nodes_v4 tcp dport {
            {{ rabbitmq_epmd_port }},
            {{ rabbitmq_distribution_port }}
        } accept
{% endif %}
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
