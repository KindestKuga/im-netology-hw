{
  "index_patterns": ["logs-*-netology44"],
  "priority": 500,
  "data_stream": {},
  "template": {
    "settings": {
      "index.number_of_replicas": 0
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {"type": "date"},
        "event": {
          "properties": {
            "dataset": {"type": "keyword"},
            "duration": {"type": "long"}
          }
        },
        "http": {
          "properties": {
            "response": {
              "properties": {
                "status_code": {"type": "integer"}
              }
            }
          }
        },
        "source": {
          "properties": {
            "ip": {"type": "ip"}
          }
        },
        "labels": {"type": "object", "dynamic": true}
      }
    }
  },
  "_meta": {
    "description": "Netology homework 44 synthetic log data streams"
  }
}
