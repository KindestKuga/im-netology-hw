output "instance_group_id" {
  description = "Compute Instance Group ID."
  value       = yandex_compute_instance_group.web.id
}

output "target_group_id" {
  description = "Target group generated by the instance group."
  value       = yandex_compute_instance_group.web.load_balancer[0].target_group_id
}

output "load_balancer_ip" {
  description = "External IPv4 address of the Network Load Balancer."
  value = one(
    one(yandex_lb_network_load_balancer.web.listener).external_address_spec
  ).address
}

output "instances" {
  description = "Instances managed by the Compute Instance Group."
  value = [
    for vm in yandex_compute_instance_group.web.instances : {
      name        = vm.name
      internal_ip = vm.network_interface[0].ip_address
      status      = vm.status
    }
  ]
}
