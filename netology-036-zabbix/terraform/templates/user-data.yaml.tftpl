#cloud-config
hostname: ${hostname}
manage_etc_hosts: true


ssh_pwauth: false
disable_root: true

package_update: true
package_upgrade: false

packages:
  - python3
  - qemu-guest-agent
  - sudo

users:
  - name: debian
    groups:
      - sudo
    shell: /bin/bash
    lock_passwd: true
    sudo:
      - ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}

runcmd:
  - [ systemctl, enable, --now, qemu-guest-agent.service ]
