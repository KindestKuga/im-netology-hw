server {
    listen 8080;
    server_name _;

    location ~* \.jpg$ {
        root /var/www;
        try_files $uri =404;

        add_header X-Served-By nginx-static always;
    }

    location / {
        proxy_pass http://127.0.0.1:8090;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
